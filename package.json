{
  "name": "pi-llmgateway",
  "version": "0.3.0",
  "description": "pi/omp extension providing an LLM Gateway inference API provider with auto-populating model list",
  "license": "MIT",
  "type": "module",
  "private": true,
  "module": "src/extensions/provider/index.ts",
  "main": "src/extensions/provider/index.ts",
  "keywords": [
    "pi",
    "pi-extension",
    "omp",
    "omp-extension",
    "llmgateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cawilliamson/pi-llmgateway.git"
  },
  "pi": {
    "extensions": [
      "./src/extensions/provider/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/extensions/provider/index.ts"
    ]
  },
  "files": [
    "src",
    "schema.json",
    "README.md",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "ts-json-schema-generator --path src/config.ts --type LLMGatewayConfig --no-type-check -o schema.json",
    "check:schema": "ts-json-schema-generator --path src/config.ts --type LLMGatewayConfig --no-type-check -o /tmp/schema-check.json && diff -q schema.json /tmp/schema-check.json"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  }
}